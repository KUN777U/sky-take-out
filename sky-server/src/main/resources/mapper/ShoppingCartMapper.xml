<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.ShoppingCartMapper">
    <insert id="insertBatch">
        insert into shopping_cart (name,dish_id,setmeal_id,dish_flavor,number,amount,image,user_id,create_time)
        values
            <foreach collection = "shoppingCartList" item = "sc" separator = ",">
                (#{sc.name},#{sc.dishId},#{sc.setmealId},#{sc.dishFlavor},#{sc.number},#{sc.amount},#{sc.userId},#{sc.createTime})
            </foreach>
    </insert>

    <select id="list" resultType="com.sky.entity.ShoppingCart">
        select * from shopping_cart
        <where>
            <if test = "userId != null">
                user_id = #{userId}
            </if>
            <if test = "setmealId != null">
                setmeal_id = #{setmealId}
            </if>
            <if test = "dishId != null">
                dish_id = #{dishId}
            </if>
            <if test = "dishFlavor != null">
                dish_flavor = #{dishFlavor}
            </if>
        </where>
    </select>
</mapper>
